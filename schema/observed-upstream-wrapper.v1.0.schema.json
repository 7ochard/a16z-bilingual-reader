{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "chatgpt-observed-1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "rights": {
      "type": "object",
      "properties": {
        "rights": {
          "type": "string",
          "enum": [
            "owned",
            "licensed",
            "public_domain",
            "permission_granted",
            "summary_only"
          ]
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "permission_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "rights",
        "copyright",
        "permission_note"
      ],
      "additionalProperties": false
    },
    "title_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "article": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "published_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "selected_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "topics": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "segments": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "type": {
                "type": "string",
                "const": "paraphrase"
              },
              "extensions": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": [
              "id",
              "en",
              "zh",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "key_findings": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "limitations": {
              "type": "string",
              "maxLength": 10000
            },
            "discussion": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "claims": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "evidence_ids": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
                    }
                  },
                  "extensions": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                },
                "required": [
                  "id",
                  "statement"
                ],
                "additionalProperties": false
              }
            },
            "evidence": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "source_url": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "segment_ids": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
                    }
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "reported",
                      "observation",
                      "inference",
                      "synthetic"
                    ]
                  },
                  "extensions": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                },
                "required": [
                  "id",
                  "description"
                ],
                "additionalProperties": false
              }
            },
            "industry_implications": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            },
            "independent_judgment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "extensions": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "summary",
            "key_findings",
            "limitations"
          ],
          "additionalProperties": false
        },
        "vocabulary": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
              },
              "segment_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,119}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "phonetic": {
                "type": "string",
                "maxLength": 200
              },
              "part_of_speech": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "meaning_zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "meaning_en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "example_en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "example_zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "extensions": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": [
              "term",
              "part_of_speech",
              "meaning_zh",
              "example_en",
              "example_zh"
            ],
            "additionalProperties": false
          }
        },
        "copyright_mode": {
          "type": "string",
          "const": "bilingual_paraphrase"
        },
        "meta": {
          "type": "object",
          "properties": {
            "content_origin": {
              "type": "string",
              "enum": [
                "synthetic",
                "original",
                "third_party_paraphrase"
              ]
            },
            "source_url": {
              "type": "string",
              "maxLength": 2000,
              "format": "uri"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "generator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "source_language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "notes": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "extensions": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "source",
        "title",
        "author",
        "published_at",
        "selected_at",
        "url",
        "topics",
        "selection_reason",
        "segments",
        "analysis",
        "vocabulary",
        "copyright_mode"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "format",
    "revision",
    "rights",
    "article"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
